# AgroVolt Backend Environment Variables Example
# Copy this to .env locally or set these in Render / Railway environment settings

# OpenWeatherMap API Key (free tier at openweathermap.org)
# If empty, the backend falls back to realistic mock weather data
OPENWEATHER_API_KEY=

# Allowed CORS Origins (comma separated list of additional URLs)
# Default already includes http://localhost:5173 and https://agrovolt.vercel.app
CORS_ORIGINS=https://agrovolt.vercel.app
